    'G': {'H': 1, 'I': 6},
    'H': {'G': 1, 'I': 7},
    'I': {}
}

start_node = 'A'
distances, previous = dijkstra(graph, start_node)

print("Shortest distances from node A:")
for node, distance in distances.items():
    print(f"{node}: {distance}")

print_path(previous, start_node, 'I')

