import sys

def floyd_warshall(graph):
    # Number of vertices in graph
    V = len(graph)

    # Initialize distance matrix
    dist = [[float('inf')] * V for _ in range(V)]

    # Initialize predecessor matrix
    pred = [[None] * V for _ in range(V)]

    # Initialize distances and predecessors
    for i in range(V):
        for j in range(V):
            if i == j:
                dist[i][j] = 0
            elif graph[i][j] != 0:
                dist[i][j] = graph[i][j]
                pred[i][j] = i

    # Main Floyd-Warshall algorithm
    for k in range(V):
        for i in range(V):
            for j in range(V):
                if dist[i][k] + dist[k][j] < dist[i][j]:
                    dist[i][j] = dist[i][k] + dist[k][j]
                    pred[i][j] = pred[k][j]

    return dist, pred

def print_path(pred, i, j):
    if i == j:
        return [chr(ord('A') + i)]
    if pred[i][j] is None:
        return [] # Handle case where there's no path
    
    # Initialize path inside function to be local
    path = []
    
    # Recursively build path
    path = print_path(pred, i, pred[i][j])
    path.append(chr(ord('A') + j))
    return path

# Define graph 
graph = [
    [0, 4, 0, 0, 0, 0, 0, 8, 0],
    [0, 0, 8, 0, 0, 0, 0, 11, 0],
    [0, 0, 0, 7, 0, 4, 0, 0, 2],
    [0, 0, 0, 0, 9, 14, 0, 0, 0],
