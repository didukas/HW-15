    [0, 0, 0, 0, 0, 0, 0, 1, 6],
    [0, 0, 0, 0, 0, 0, 1, 0, 7],
    [0, 0, 0, 0, 0, 0, 0, 0, 0]
]

# Run Floyd-Warshall algorithm
dist, pred = floyd_warshall(graph)

# Print all-pairs shortest paths
for i in range(len(graph)):
    for j in range(len(graph)):
        if i != j:
            path = print_path(pred, i, j)
            if path:
                print(f"Shortest path from {chr(ord('A') + i)} to {chr(ord('A') + j)}: "
                      f"{' -> '.join(path)} (distance: {dist[i][j]})")
            else:
                print(f"No path from {chr(ord('A') + i)} to {chr(ord('A') + j)}")

